    ],
    "template": "cq.Workplane(\"XY\").box({length}, {width}, {height}).faces(\">Z\").workplane().cskHole({hole_diameter}, {csink_diameter}, {csink_angle}, depth={height})"
  },
  "shaft_with_keyway": {
    "name": "shaft_with_keyway",
    "description": "A cylindrical shaft with a rectangular keyway cut along its side.",
    "parameters": {
      "diameter": {
        "type": "float",
        "description": "Diameter of the shaft",
        "default": 10.0
      },
      "length": {
        "type": "float",
        "description": "Length of the shaft",
        "default": 30.0
      },
      "key_width": {
        "type": "float",
        "description": "Width of the keyway",
        "default": 3.0
      },
      "key_depth": {
        "type": "float",
        "description": "Depth of the keyway",
        "default": 1.5
      },
      "key_length": {
        "type": "float",
        "description": "Length of the keyway from one end",
        "default": 20.0
      }
    },
    "verification": [
