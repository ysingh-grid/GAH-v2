      "measure_key_length"
    ],
    "template": "cq.Workplane(\"XY\").cylinder({length}, {diameter}/2.0).faces(\">Z\").workplane().center(0, {diameter}/2.0 - {key_depth}/2.0).rect({key_width}, {key_depth}).extrude(-{key_length}, combine=\"cut\")"
  },
  "circular_flange": {
    "name": "circular_flange",
    "description": "A circular flange pipe connector with a circular pattern of bolt holes.",
    "parameters": {
      "outer_diameter": {
        "type": "float",
        "description": "Outer diameter of flange disc",
        "default": 25.0
      },
      "thickness": {
        "type": "float",
        "description": "Thickness of the flange disc",
        "default": 4.0
      },
      "pipe_diameter": {
        "type": "float",
        "description": "Central pipe inner diameter",
        "default": 10.0
      },
      "bolt_circle_diameter": {
        "type": "float",
        "description": "Diameter of bolt circle pattern",
        "default": 18.0
      },
      "bolt_hole_diameter": {
        "type": "float",
        "description": "Diameter of bolt holes",
        "default": 3.0
      },
      "num_bolt_holes": {
        "type": "int",
        "description": "Number of bolt holes in pattern",
        "default": 6
      }
    },
    "verification": [
