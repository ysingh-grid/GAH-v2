    ],
    "template": "cq.Workplane(\"XY\").box({length}, {width}, {height}).faces(\">Z\").workplane().cboreHole({hole_diameter}, {cbore_diameter}, {cbore_depth}, depth={height})"
  },
  "countersink_hole_block": {
    "name": "countersink_hole_block",
