      "measure_thickness",
      "measure_pipe_diameter",
      "measure_bolt_circle_diameter",
      "measure_bolt_hole_diameter",
      "measure_num_bolt_holes"
    ],
    "template": "cq.Workplane(\"XY\").circle({outer_diameter}/2.0).circle({pipe_diameter}/2.0).extrude({thickness}).faces(\">Z\").workplane().polarArray({bolt_circle_diameter}/2.0, 0.0, 360.0, {num_bolt_holes}).hole({bolt_hole_diameter})"
  }
}