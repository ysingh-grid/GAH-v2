{
  "box": {
    "name": "box",
    "description": "A standard 3D rectangular box defined by length, width, and height.",
    "parameters": {
      "length": {
        "type": "float",
        "description": "Size along the X axis",
        "default": 10.0
      },
      "width": {
        "type": "float",
        "description": "Size along the Y axis",
        "default": 10.0
      },
      "height": {
        "type": "float",
        "description": "Size along the Z axis",
        "default": 10.0
      }
    },
    "verification": [
      "measure_length",
      "measure_width",
      "measure_height"
    ],
    "template": "cq.Workplane(\"XY\").box({length}, {width}, {height})"
  },
  "cylinder": {
    "name": "cylinder",
    "description": "A standard cylinder defined by its radius and height.",
    "parameters": {
      "radius": {
        "type": "float",
        "description": "Radius of the circular profile",
        "default": 5.0
      },
      "height": {
        "type": "float",
        "description": "Height along the cylinder axis",
        "default": 10.0
      }
    },
    "verification": [
      "measure_radius",
      "measure_height"
    ],
    "template": "cq.Workplane(\"XY\").cylinder({height}, {radius})"
  },
  "cone": {
    "name": "cone",
    "description": "A cone (or truncated cone / frustum) defined by base diameter, top diameter (default 0), and height.",
    "parameters": {
      "base_diameter": {
        "type": "float",
        "description": "Diameter of the bottom circle",
        "default": 10.0
      },
      "top_diameter": {
        "type": "float",
        "description": "Diameter of the top circle (0 for a sharp cone)",
        "default": 0.0
      },
      "height": {
        "type": "float",
        "description": "Height along the cone axis",
        "default": 10.0
      }
    },
    "verification": [
      "measure_base_diameter",
      "measure_top_diameter",
      "measure_height"
    ],
    "template": "cq.Workplane(\"XY\").add(cq.Solid.makeCone({base_diameter}/2.0, {top_diameter}/2.0, {height}))"
  },
  "sphere": {
    "name": "sphere",
    "description": "A sphere defined by its radius.",
    "parameters": {
      "radius": {
        "type": "float",
        "description": "Radius of the sphere",
        "default": 5.0
      }
    },
    "verification": [
      "measure_radius"
    ],
    "template": "cq.Workplane(\"XY\").sphere({radius})"
  },
  "torus": {
    "name": "torus",
    "description": "A donut-shaped torus defined by the major (ring) radius and minor (tube) radius.",
    "parameters": {
      "ring_radius": {
        "type": "float",
        "description": "Distance from the center of the torus to the center of the tube",
        "default": 10.0
      },
      "tube_radius": {
        "type": "float",
        "description": "Radius of the tube",
        "default": 2.0
      }
    },
    "verification": [
      "measure_ring_radius",
      "measure_tube_radius"
    ],
    "template": "cq.Workplane(\"XY\").add(cq.Solid.makeTorus({ring_radius}, {tube_radius}))"
  },
  "wedge": {
    "name": "wedge",
    "description": "A standard wedge defined by length (dx), width (dy), height (dz), and offsets.",
    "parameters": {
      "dx": {
        "type": "float",
        "description": "Length along X axis",
        "default": 10.0
      },
      "dy": {
        "type": "float",
        "description": "Width along Y axis",
        "default": 10.0
      },
      "dz": {
        "type": "float",
        "description": "Height along Z axis",
        "default": 10.0
      },
      "xmin": {
        "type": "float",
        "description": "Start position on X",
        "default": 0.0
      },
      "ymin": {
        "type": "float",
        "description": "Start position on Y",
        "default": 0.0
      },
      "xmax": {
        "type": "float",
        "description": "End position on X",
        "default": 5.0
      },
      "ymax": {
        "type": "float",
        "description": "End position on Y",
        "default": 5.0
      }
    },
    "verification": [
      "measure_dx",
      "measure_dy",
      "measure_dz"
    ],
    "template": "cq.Workplane(\"XY\").wedge({dx}, {dy}, {dz}, {xmin}, {ymin}, {xmax}, {ymax})"
  },
  "pyramid": {
    "name": "pyramid",
    "description": "A pyramid built by extruding a rectangular base with a taper angle.",
    "parameters": {
      "length": {
        "type": "float",
        "description": "Base length along X",
        "default": 10.0
      },
      "width": {
        "type": "float",
        "description": "Base width along Y",
        "default": 10.0
      },
      "height": {
        "type": "float",
        "description": "Height along Z",
        "default": 10.0
      },
      "taper_angle": {
        "type": "float",
        "description": "Taper angle in degrees",
        "default": 30.0
      }
    },
    "verification": [
      "measure_length",
      "measure_width",
      "measure_height"
    ],
    "template": "cq.Workplane(\"XY\").rect({length}, {width}).extrude({height}, taper={taper_angle})"
  },
  "prism": {
    "name": "prism",
    "description": "A regular polygon prism defined by number of sides, radius, and height.",
    "parameters": {
      "sides": {
        "type": "int",
        "description": "Number of sides of the polygon base",
        "default": 5
      },
      "radius": {
        "type": "float",
        "description": "Distance from center to base vertices",
        "default": 5.0
      },
      "height": {
        "type": "float",
        "description": "Height of extrusion",
        "default": 10.0
      }
    },
    "verification": [
      "measure_sides",
      "measure_radius",
      "measure_height"
    ],
    "template": "cq.Workplane(\"XY\").polygon({sides}, {radius}*2.0).extrude({height})"
  },
  "hexagon_prism": {
    "name": "hexagon_prism",
    "description": "A hexagonal prism defined by the flat-to-flat diameter and height.",
    "parameters": {
      "flat_to_flat": {
        "type": "float",
        "description": "Distance between parallel flat faces",
        "default": 10.0
      },
      "height": {
        "type": "float",
        "description": "Height of the prism",
        "default": 10.0
      }
    },
    "verification": [
      "measure_flat_to_flat",
      "measure_height"
    ],
    "template": "cq.Workplane(\"XY\").polygon(6, {flat_to_flat}, circumscribed=True).extrude({height})"
  },
  "octagonal_prism": {
    "name": "octagonal_prism",
    "description": "An octagonal prism defined by flat-to-flat distance and height.",
    "parameters": {
      "flat_to_flat": {
        "type": "float",
        "description": "Distance between parallel flat faces",
        "default": 10.0
      },
      "height": {
        "type": "float",
        "description": "Height of the prism",
        "default": 10.0
      }
    },
    "verification": [
      "measure_flat_to_flat",
      "measure_height"
    ],
    "template": "cq.Workplane(\"XY\").polygon(8, {flat_to_flat}, circumscribed=True).extrude({height})"
  },
  "hollow_cylinder": {
    "name": "hollow_cylinder",
    "description": "A tube or hollow cylinder defined by outer radius, inner radius, and height.",
    "parameters": {
      "outer_radius": {
        "type": "float",
        "description": "Outer radius",
        "default": 5.0
      },
      "inner_radius": {
        "type": "float",
        "description": "Inner radius",
        "default": 3.0
      },
      "height": {
        "type": "float",
        "description": "Height",
        "default": 10.0
      }
    },
    "verification": [
      "measure_outer_radius",
      "measure_inner_radius",
      "measure_height"
    ],
    "template": "cq.Workplane(\"XY\").circle({outer_radius}).circle({inner_radius}).extrude({height})"
  },
  "hollow_box": {
    "name": "hollow_box",
    "description": "A box hollowed out by removing the top face (+Z) with a specified wall thickness.",
    "parameters": {
      "length": {
        "type": "float",
        "description": "Length along X",
        "default": 10.0
      },
      "width": {
        "type": "float",
        "description": "Width along Y",
        "default": 10.0
      },
      "height": {
        "type": "float",
        "description": "Height along Z",
        "default": 10.0
      },
      "wall_thickness": {
        "type": "float",
        "description": "Wall thickness",
        "default": 1.0
      }
    },
    "verification": [
      "measure_length",
      "measure_width",
      "measure_height",
      "measure_wall_thickness"
    ],
    "template": "cq.Workplane(\"XY\").box({length}, {width}, {height}).faces(\">Z\").shell(-{wall_thickness})"
  },
  "ellipsoid": {
    "name": "ellipsoid",
    "description": "An ellipsoid defined by revolving a half ellipse profile around the active Y-axis.",
    "parameters": {
      "x_radius": {
        "type": "float",
        "description": "Radius along X axis",
        "default": 5.0
      },
      "z_radius": {
        "type": "float",
        "description": "Radius along Z axis",
        "default": 3.0
      }
    },
    "verification": [
      "measure_x_radius",
      "measure_z_radius"
    ],
    "template": "cq.Workplane(\"XY\").ellipseArc({x_radius}, {z_radius}, 0, 180).close().revolve()"
  },
  "capsule": {
    "name": "capsule",
    "description": "A cylinder capped with two spheres on each end.",
    "parameters": {
      "radius": {
        "type": "float",
        "description": "Radius of cylinder and caps",
        "default": 3.0
      },
      "length": {
        "type": "float",
        "description": "Length of the cylindrical body",
        "default": 8.0
      }
    },
    "verification": [
      "measure_radius",
      "measure_length"
    ],
    "template": "cq.Workplane(\"XY\").cylinder({length}, {radius}).union(cq.Workplane(\"XY\").workplane(offset={length}/2.0).sphere({radius})).union(cq.Workplane(\"XY\").workplane(offset=-{length}/2.0).sphere({radius}))"
  },
  "chamfered_box": {
    "name": "chamfered_box",
    "description": "A rectangular box with chamfered edges.",
    "parameters": {
      "length": {
        "type": "float",
        "description": "Size along the X axis",
        "default": 10.0
      },
      "width": {
        "type": "float",
        "description": "Size along the Y axis",
        "default": 10.0
      },
      "height": {
        "type": "float",
        "description": "Size along the Z axis",
        "default": 10.0
      },
      "chamfer_val": {
        "type": "float",
        "description": "Chamfer dimension",
        "default": 1.0
      }
    },
    "verification": [
      "measure_length",
      "measure_width",
      "measure_height",
      "measure_chamfer"
    ],
    "template": "cq.Workplane(\"XY\").box({length}, {width}, {height}).chamfer({chamfer_val})"
  },
  "filleted_box": {
    "name": "filleted_box",
    "description": "A rectangular box with filleted edges.",
    "parameters": {
      "length": {
        "type": "float",
        "description": "Size along the X axis",
        "default": 10.0
      },
      "width": {
        "type": "float",
        "description": "Size along the Y axis",
        "default": 10.0
      },
      "height": {
        "type": "float",
        "description": "Size along the Z axis",
        "default": 10.0
      },
      "fillet_val": {
        "type": "float",
        "description": "Fillet radius",
        "default": 1.0
      }
    },
    "verification": [
      "measure_length",
      "measure_width",
      "measure_height",
      "measure_fillet"
    ],
    "template": "cq.Workplane(\"XY\").box({length}, {width}, {height}).fillet({fillet_val})"
  },
  "rounded_cylinder": {
    "name": "rounded_cylinder",
    "description": "A cylinder with filleted end edges.",
    "parameters": {
      "radius": {
        "type": "float",
        "description": "Radius of the cylinder base",
        "default": 5.0
      },
      "height": {
        "type": "float",
        "description": "Height of the cylinder",
        "default": 10.0
      },
      "fillet_val": {
        "type": "float",
        "description": "Fillet radius on the cylinder edges",
        "default": 0.5
      }
    },
    "verification": [
      "measure_radius",
      "measure_height",
      "measure_fillet"
    ],
    "template": "cq.Workplane(\"XY\").cylinder({height}, {radius}).edges().fillet({fillet_val})"
  },
  "ring": {
    "name": "ring",
    "description": "A flat concentric ring profile extruded to a thickness.",
    "parameters": {
      "outer_radius": {
        "type": "float",
        "description": "Outer radius of the ring",
        "default": 10.0
      },
      "inner_radius": {
        "type": "float",
        "description": "Inner radius of the ring",
        "default": 7.0
      },
      "thickness": {
        "type": "float",
        "description": "Thickness of the ring",
        "default": 2.0
      }
    },
    "verification": [
      "measure_outer_radius",
      "measure_inner_radius",
      "measure_thickness"
    ],
    "template": "cq.Workplane(\"XY\").circle({outer_radius}).circle({inner_radius}).extrude({thickness})"
  },
  "triangular_prism": {
    "name": "triangular_prism",
    "description": "A prism with a triangular base defined by base_width, base_height, and extrusion height.",
    "parameters": {
      "base_width": {
        "type": "float",
        "description": "Width of the triangular base",
        "default": 10.0
      },
      "base_height": {
        "type": "float",
        "description": "Height of the triangular base profile",
        "default": 8.0
      },
      "height": {
        "type": "float",
        "description": "Extrusion height of the prism",
        "default": 10.0
      }
    },
    "verification": [
      "measure_base_width",
      "measure_base_height",
      "measure_height"
    ],
    "template": "cq.Workplane(\"XY\").moveTo(-{base_width}/2.0, -{base_height}/2.0).lineTo({base_width}/2.0, -{base_height}/2.0).lineTo(0, {base_height}/2.0).close().extrude({height})"
  },
  "slot_prism": {
    "name": "slot_prism",
    "description": "A prism extruded from a 2D obround/slot profile.",
    "parameters": {
      "length": {
        "type": "float",
        "description": "Overall length of the slot profile",
        "default": 15.0
      },
      "width": {
        "type": "float",
        "description": "Overall width of the slot profile",
        "default": 5.0
      },
      "height": {
        "type": "float",
        "description": "Extrusion height of the prism",
        "default": 10.0
      }
    },
    "verification": [
      "measure_length",
      "measure_width",
      "measure_height"
    ],
    "template": "cq.Workplane(\"XY\").slot2D({length}, {width}).extrude({height})"
  },
  "elliptical_cylinder": {
    "name": "elliptical_cylinder",
    "description": "A cylinder with an elliptical cross-section.",
    "parameters": {
      "x_radius": {
        "type": "float",
        "description": "Radius along X axis",
        "default": 5.0
      },
      "y_radius": {
        "type": "float",
        "description": "Radius along Y axis",
        "default": 3.0
      },
      "height": {
        "type": "float",
        "description": "Extrusion height along Z axis",
        "default": 10.0
      }
    },
    "verification": [
      "measure_x_radius",
      "measure_y_radius",
      "measure_height"
    ],
    "template": "cq.Workplane(\"XY\").ellipse({x_radius}, {y_radius}).extrude({height})"
  },
  "elliptical_ring": {
    "name": "elliptical_ring",
    "description": "A flat concentric elliptical ring profile extruded to a thickness.",
    "parameters": {
      "outer_x_radius": {
        "type": "float",
        "description": "Outer radius along X axis",
        "default": 10.0
      },
      "outer_y_radius": {
        "type": "float",
        "description": "Outer radius along Y axis",
        "default": 7.0
      },
      "inner_x_radius": {
        "type": "float",
        "description": "Inner radius along X axis",
        "default": 5.0
      },
      "inner_y_radius": {
        "type": "float",
        "description": "Inner radius along Y axis",
        "default": 3.0
      },
      "thickness": {
        "type": "float",
        "description": "Extrusion thickness",
        "default": 2.0
      }
    },
    "verification": [
      "measure_outer_x_radius",
      "measure_outer_y_radius",
      "measure_inner_x_radius",
      "measure_inner_y_radius",
      "measure_thickness"
    ],
    "template": "cq.Workplane(\"XY\").ellipse({outer_x_radius}, {outer_y_radius}).ellipse({inner_x_radius}, {inner_y_radius}).extrude({thickness})"
  },
  "t_prism": {
    "name": "t_prism",
    "description": "A T-shaped prism (T-beam) extruded profile.",
    "parameters": {
      "flange_width": {
        "type": "float",
        "description": "Width of the top flange",
        "default": 10.0
      },
      "flange_thickness": {
        "type": "float",
        "description": "Thickness of the top flange",
        "default": 2.0
      },
      "web_height": {
        "type": "float",
        "description": "Height of the web beneath the flange",
        "default": 8.0
      },
      "web_thickness": {
        "type": "float",
        "description": "Thickness of the web",
        "default": 2.0
      },
      "length": {
        "type": "float",
        "description": "Extrusion length",
        "default": 20.0
      }
    },
    "verification": [
      "measure_flange_width",
      "measure_flange_thickness",
      "measure_web_height",
      "measure_web_thickness",
      "measure_length"
    ],
    "template": "cq.Workplane(\"XY\").moveTo(-{flange_width}/2.0, {web_height}/2.0+{flange_thickness}).lineTo({flange_width}/2.0, {web_height}/2.0+{flange_thickness}).lineTo({flange_width}/2.0, {web_height}/2.0).lineTo({web_thickness}/2.0, {web_height}/2.0).lineTo({web_thickness}/2.0, -{web_height}/2.0).lineTo(-{web_thickness}/2.0, -{web_height}/2.0).lineTo(-{web_thickness}/2.0, {web_height}/2.0).lineTo(-{flange_width}/2.0, {web_height}/2.0).close().extrude({length})"
  },
  "i_beam": {
    "name": "i_beam",
    "description": "An I-shaped beam extruded profile.",
    "parameters": {
      "flange_width": {
        "type": "float",
        "description": "Width of the flanges",
        "default": 10.0
      },
      "flange_thickness": {
        "type": "float",
        "description": "Thickness of the flanges",
        "default": 2.0
      },
      "web_height": {
        "type": "float",
        "description": "Distance between the two flanges",
        "default": 8.0
      },
      "web_thickness": {
        "type": "float",
        "description": "Thickness of the vertical web",
        "default": 2.0
      },
      "length": {
        "type": "float",
        "description": "Extrusion length",
        "default": 20.0
      }
    },
    "verification": [
      "measure_flange_width",
      "measure_flange_thickness",
      "measure_web_height",
      "measure_web_thickness",
      "measure_length"
    ],
    "template": "cq.Workplane(\"XY\").moveTo(-{flange_width}/2.0, {web_height}/2.0+{flange_thickness}).lineTo({flange_width}/2.0, {web_height}/2.0+{flange_thickness}).lineTo({flange_width}/2.0, {web_height}/2.0).lineTo({web_thickness}/2.0, {web_height}/2.0).lineTo({web_thickness}/2.0, -{web_height}/2.0).lineTo({flange_width}/2.0, -{web_height}/2.0).lineTo({flange_width}/2.0, -({web_height}/2.0+{flange_thickness})).lineTo(-{flange_width}/2.0, -({web_height}/2.0+{flange_thickness})).lineTo(-{flange_width}/2.0, -{web_height}/2.0).lineTo(-{web_thickness}/2.0, -{web_height}/2.0).lineTo(-{web_thickness}/2.0, {web_height}/2.0).lineTo(-{flange_width}/2.0, {web_height}/2.0).close().extrude({length})"
  },
  "l_prism": {
    "name": "l_prism",
    "description": "An L-shaped prism (Angle iron) extruded profile.",
    "parameters": {
      "flange_x": {
        "type": "float",
        "description": "Length of horizontal leg",
        "default": 10.0
      },
      "flange_y": {
        "type": "float",
        "description": "Length of vertical leg",
        "default": 10.0
      },
      "thickness": {
        "type": "float",
        "description": "Thickness of the legs",
        "default": 2.0
      },
      "length": {
        "type": "float",
        "description": "Extrusion length",
        "default": 20.0
      }
    },
    "verification": [
      "measure_flange_x",
      "measure_flange_y",
      "measure_thickness",
      "measure_length"
    ],
    "template": "cq.Workplane(\"XY\").moveTo(-{flange_x}/2.0, -{flange_y}/2.0).lineTo({flange_x}/2.0, -{flange_y}/2.0).lineTo({flange_x}/2.0, -{flange_y}/2.0 + {thickness}).lineTo(-{flange_x}/2.0 + {thickness}, -{flange_y}/2.0 + {thickness}).lineTo(-{flange_x}/2.0 + {thickness}, {flange_y}/2.0).lineTo(-{flange_x}/2.0, {flange_y}/2.0).close().extrude({length})"
  },
  "trapezoidal_prism": {
    "name": "trapezoidal_prism",
    "description": "A prism with a trapezoidal profile base.",
    "parameters": {
      "base_large": {
        "type": "float",
        "description": "Width of the larger parallel side",
        "default": 10.0
      },
      "base_small": {
        "type": "float",
        "description": "Width of the smaller parallel side",
        "default": 6.0
      },
      "height_trapezoid": {
        "type": "float",
        "description": "Height of the trapezoid profile",
        "default": 5.0
      },
      "length": {
        "type": "float",
        "description": "Extrusion length of the prism",
        "default": 10.0
      }
    },
    "verification": [
      "measure_base_large",
      "measure_base_small",
      "measure_height_trapezoid",
      "measure_length"
    ],
    "template": "cq.Workplane(\"XY\").moveTo(-{base_large}/2.0, -{height_trapezoid}/2.0).lineTo({base_large}/2.0, -{height_trapezoid}/2.0).lineTo({base_small}/2.0, {height_trapezoid}/2.0).lineTo(-{base_small}/2.0, {height_trapezoid}/2.0).close().extrude({length})"
  },
  "dome": {
    "name": "dome",
    "description": "A dome or hemisphere defined by its radius.",
    "parameters": {
      "radius": {
        "type": "float",
        "description": "Radius of the dome",
        "default": 5.0
      }
    },
    "verification": [
      "measure_radius"
    ],
    "template": "cq.Workplane(\"XY\").sphere({radius}).cut(cq.Workplane(\"XY\").rect({radius}*3.0, {radius}*3.0).extrude(-{radius}))"
  },
  "pipe": {
    "name": "pipe",
    "description": "A hollow cylinder defined by outer diameter and wall thickness.",
    "parameters": {
      "outer_diameter": {
        "type": "float",
        "description": "Outer diameter of the pipe",
        "default": 10.0
      },
      "wall_thickness": {
        "type": "float",
        "description": "Thickness of the pipe wall",
        "default": 1.0
      },
      "length": {
        "type": "float",
        "description": "Length of the pipe",
        "default": 20.0
      }
    },
    "verification": [
      "measure_outer_diameter",
      "measure_wall_thickness",
      "measure_length"
    ],
    "template": "cq.Workplane(\"XY\").circle({outer_diameter}/2.0).circle({outer_diameter}/2.0 - {wall_thickness}).extrude({length})"
  },
  "hex_nut_blank": {
    "name": "hex_nut_blank",
    "description": "A hexagonal prism with a central clearance hole.",
    "parameters": {
      "flat_to_flat": {
        "type": "float",
        "description": "Distance between parallel flat faces",
        "default": 10.0
      },
      "hole_diameter": {
        "type": "float",
        "description": "Diameter of central clearance hole",
        "default": 5.0
      },
      "height": {
        "type": "float",
        "description": "Height of the nut",
        "default": 5.0
      }
    },
    "verification": [
      "measure_flat_to_flat",
      "measure_hole_diameter",
      "measure_height"
    ],
    "template": "cq.Workplane(\"XY\").polygon(6, {flat_to_flat}, circumscribed=True).circle({hole_diameter}/2.0).extrude({height})"
  },
  "hex_bolt_blank": {
    "name": "hex_bolt_blank",
    "description": "A bolt shape consisting of a hexagonal head and a cylindrical shank.",
    "parameters": {
      "head_flat_to_flat": {
        "type": "float",
        "description": "Hexagonal head flat-to-flat distance",
        "default": 10.0
      },
      "head_height": {
        "type": "float",
        "description": "Height/thickness of the hexagonal head",
        "default": 4.0
      },
      "shank_diameter": {
        "type": "float",
        "description": "Diameter of cylindrical shank",
        "default": 5.0
      },
      "shank_length": {
        "type": "float",
        "description": "Length of cylindrical shank",
        "default": 15.0
      }
    },
    "verification": [
      "measure_head_flat_to_flat",
      "measure_head_height",
      "measure_shank_diameter",
      "measure_shank_length"
    ],
    "template": "cq.Workplane(\"XY\").polygon(6, {head_flat_to_flat}, circumscribed=True).extrude({head_height}).faces(\">Z\").workplane().circle({shank_diameter}/2.0).extrude({shank_length})"
  },
  "cross_prism": {
    "name": "cross_prism",
    "description": "A cross-shaped prism defined by overall length, width, arm thickness, and height.",
    "parameters": {
      "length": {
        "type": "float",
        "description": "Total length along X axis",
        "default": 10.0
      },
      "width": {
        "type": "float",
        "description": "Total width along Y axis",
        "default": 10.0
      },
      "thickness": {
        "type": "float",
        "description": "Thickness of the cross arms",
        "default": 3.0
      },
      "height": {
        "type": "float",
        "description": "Height along Z axis",
        "default": 10.0
      }
    },
    "verification": [
      "measure_length",
      "measure_width",
      "measure_thickness",
      "measure_height"
    ],
    "template": "cq.Workplane(\"XY\").rect({length}, {thickness}).rect({thickness}, {width}).extrude({height})"
  },
  "c_channel": {
    "name": "c_channel",
    "description": "A C-channel structural profile defined by overall width, height, thickness, and length.",
    "parameters": {
      "width": {
        "type": "float",
        "description": "Overall width of the channel",
        "default": 10.0
      },
      "height": {
        "type": "float",
        "description": "Overall height of the channel profile",
        "default": 10.0
      },
      "thickness": {
        "type": "float",
        "description": "Thickness of the channel walls",
        "default": 2.0
      },
      "length": {
        "type": "float",
        "description": "Extrusion length of the channel",
        "default": 20.0
      }
    },
    "verification": [
      "measure_width",
      "measure_height",
      "measure_thickness",
      "measure_length"
    ],
    "template": "cq.Workplane(\"XY\").moveTo(-{width}/2.0, -{height}/2.0).lineTo({width}/2.0, -{height}/2.0).lineTo({width}/2.0, -{height}/2.0+{thickness}).lineTo(-{width}/2.0+{thickness}, -{height}/2.0+{thickness}).lineTo(-{width}/2.0+{thickness}, {height}/2.0-{thickness}).lineTo({width}/2.0, {height}/2.0-{thickness}).lineTo({width}/2.0, {height}/2.0).lineTo(-{width}/2.0, {height}/2.0).close().extrude({length})"
  },
  "counterbore_hole_block": {
    "name": "counterbore_hole_block",
    "description": "A rectangular block with a center counterbore hole.",
    "parameters": {
      "length": {
