{
  "box": {
    "name": "box",
    "description": "A standard 3D rectangular box defined by length, width, and height.",
    "parameters": {
      "length": {
        "type": "float",
        "description": "Size along the X axis",
        "default": 10.0
      },
      "width": {
        "type": "float",
        "description": "Size along the Y axis",
        "default": 10.0
      },
      "height": {
        "type": "float",
        "description": "Size along the Z axis",
        "default": 10.0
      }
    },
    "template": "cq.Workplane(\"XY\").box({length}, {width}, {height})"
  },
  "cylinder": {
    "name": "cylinder",
    "description": "A standard cylinder defined by its radius and height.",
    "parameters": {
      "radius": {
        "type": "float",
        "description": "Radius of the circular profile",
        "default": 5.0
      },
      "height": {
        "type": "float",
        "description": "Height along the cylinder axis",
        "default": 10.0
      }
    },
    "template": "cq.Workplane(\"XY\").cylinder({height}, {radius})"
  },
  "cone": {
    "name": "cone",
    "description": "A cone (or truncated cone / frustum) defined by base diameter, top diameter (default 0), and height.",
    "parameters": {
      "base_diameter": {
        "type": "float",
        "description": "Diameter of the bottom circle",
        "default": 10.0
      },
      "top_diameter": {
        "type": "float",
        "description": "Diameter of the top circle (0 for a sharp cone)",
        "default": 0.0
      },
      "height": {
        "type": "float",
        "description": "Height along the cone axis",
        "default": 10.0
      }
    },
    "template": "cq.Workplane(\"XY\").add(cq.Solid.makeCone({base_diameter}/2.0, {top_diameter}/2.0, {height}))"
  },
  "sphere": {
    "name": "sphere",
    "description": "A sphere defined by its radius.",
    "parameters": {
      "radius": {
        "type": "float",
        "description": "Radius of the sphere",
        "default": 5.0
      }
    },
    "template": "cq.Workplane(\"XY\").sphere({radius})"
  },
  "torus": {
    "name": "torus",
    "description": "A donut-shaped torus defined by the major (ring) radius and minor (tube) radius.",
    "parameters": {
      "ring_radius": {
        "type": "float",
        "description": "Distance from the center of the torus to the center of the tube",
        "default": 10.0
      },
      "tube_radius": {
        "type": "float",
        "description": "Radius of the tube",
        "default": 2.0
      }
    },
    "template": "cq.Workplane(\"XY\").add(cq.Solid.makeTorus({ring_radius}, {tube_radius}))"
  },
  "wedge": {
    "name": "wedge",
    "description": "A standard wedge defined by length (dx), width (dy), height (dz), and offsets.",
    "parameters": {
      "dx": {
        "type": "float",
        "description": "Length along X axis",
        "default": 10.0
      },
      "dy": {
        "type": "float",
        "description": "Width along Y axis",
        "default": 10.0
      },
      "dz": {
        "type": "float",
        "description": "Height along Z axis",
        "default": 10.0
      },
      "xmin": {
        "type": "float",
        "description": "Start position on X",
        "default": 0.0
      },
      "ymin": {
        "type": "float",
        "description": "Start position on Y",
        "default": 0.0
      },
      "xmax": {
        "type": "float",
        "description": "End position on X",
        "default": 5.0
      },
      "ymax": {
        "type": "float",
        "description": "End position on Y",
        "default": 5.0
      }
    },
    "template": "cq.Workplane(\"XY\").wedge({dx}, {dy}, {dz}, {xmin}, {ymin}, {xmax}, {ymax})"
  },
  "pyramid": {
    "name": "pyramid",
    "description": "A pyramid: rectangular base lofted to an apex point at the given height.",
    "parameters": {
      "length": {
        "type": "float",
        "description": "Base length along X",
        "default": 10.0
      },
      "width": {
        "type": "float",
        "description": "Base width along Y",
        "default": 10.0
      },
      "height": {
        "type": "float",
        "description": "Height along Z",
        "default": 10.0
      },
      "taper_angle": {
        "type": "float",
        "description": "Unused (kept for schema compat); apex is a point",
        "default": 30.0
      }
    },
    "template": "cq.Workplane(\"XY\").rect({length}, {width}).workplane(offset={height}).rect(0.001, 0.001).loft(combine=True)"
  },
  "prism": {
    "name": "prism",
    "description": "A regular polygon prism defined by number of sides, radius, and height.",
    "parameters": {
      "sides": {
        "type": "int",
        "description": "Number of sides of the polygon base",
        "default": 5
      },
      "radius": {
        "type": "float",
        "description": "Distance from center to base vertices",
        "default": 5.0
      },
      "height": {
        "type": "float",
        "description": "Height of extrusion",
        "default": 10.0
      }
    },
    "template": "cq.Workplane(\"XY\").polygon({sides}, {radius}*2.0).extrude({height})"
  },
  "hexagon_prism": {
    "name": "hexagon_prism",
    "description": "A hexagonal prism defined by the flat-to-flat diameter and height.",
    "parameters": {
      "flat_to_flat": {
        "type": "float",
        "description": "Distance between parallel flat faces",
        "default": 10.0
      },
      "height": {
        "type": "float",
        "description": "Height of the prism",
        "default": 10.0
      }
    },
    "template": "cq.Workplane(\"XY\").polygon(6, {flat_to_flat}, circumscribed=True).extrude({height})"
  },
  "octagonal_prism": {
    "name": "octagonal_prism",
    "description": "An octagonal prism defined by flat-to-flat distance and height.",
    "parameters": {
      "flat_to_flat": {
        "type": "float",
        "description": "Distance between parallel flat faces",
        "default": 10.0
      },
      "height": {
        "type": "float",
        "description": "Height of the prism",
        "default": 10.0
      }
    },
    "template": "cq.Workplane(\"XY\").polygon(8, {flat_to_flat}, circumscribed=True).extrude({height})"
  },
  "hollow_cylinder": {
    "name": "hollow_cylinder",
    "description": "A tube or hollow cylinder defined by outer radius, inner radius, and height.",
    "parameters": {
      "outer_radius": {
        "type": "float",
        "description": "Outer radius",
        "default": 5.0
      },
      "inner_radius": {
        "type": "float",
        "description": "Inner radius",
        "default": 3.0
      },
      "height": {
        "type": "float",
        "description": "Height",
        "default": 10.0
      }
    },
    "template": "cq.Workplane(\"XY\").circle({outer_radius}).circle({inner_radius}).extrude({height})"
  },
  "hollow_box": {
    "name": "hollow_box",
    "description": "A box hollowed out by removing the top face (+Z) with a specified wall thickness.",
    "parameters": {
      "length": {
        "type": "float",
        "description": "Length along X",
        "default": 10.0
      },
      "width": {
        "type": "float",
        "description": "Width along Y",
        "default": 10.0
      },
      "height": {
        "type": "float",
        "description": "Height along Z",
        "default": 10.0
      },
      "wall_thickness": {
        "type": "float",
        "description": "Wall thickness",
        "default": 1.0
      }
    },
    "template": "cq.Workplane(\"XY\").box({length}, {width}, {height}).faces(\">Z\").shell(-{wall_thickness})"
  },
  "ellipsoid": {
    "name": "ellipsoid",
    "description": "A true ellipsoid: unit sphere scaled to x_radius (X,Y) and z_radius (Z).",
    "parameters": {
      "x_radius": {
        "type": "float",
        "description": "Radius along X and Y axes",
        "default": 5.0
      },
      "z_radius": {
        "type": "float",
        "description": "Radius along Z axis",
        "default": 3.0
      }
    },
    "template": "cq.Workplane(\"XY\").add(cq.Workplane(\"XY\").sphere(1.0).val().transformGeometry(cq.Matrix([[{x_radius}, 0, 0, 0], [0, {x_radius}, 0, 0], [0, 0, {z_radius}, 0]])))"
  },
  "capsule": {
    "name": "capsule",
    "description": "A cylinder capped with two spheres on each end.",
    "parameters": {
      "radius": {
        "type": "float",
        "description": "Radius of cylinder and caps",
        "default": 3.0
      },
      "length": {
        "type": "float",
        "description": "Length of the cylindrical body",
        "default": 8.0
      }
    },
    "template": "cq.Workplane(\"XY\").cylinder({length}, {radius}).union(cq.Workplane(\"XY\").workplane(offset={length}/2.0).sphere({radius})).union(cq.Workplane(\"XY\").workplane(offset=-{length}/2.0).sphere({radius}))"
  },
  "chamfered_box": {
    "name": "chamfered_box",
    "description": "A rectangular box with chamfered edges.",
    "parameters": {
      "length": {
        "type": "float",
        "description": "Size along the X axis",
        "default": 10.0
      },
      "width": {
        "type": "float",
        "description": "Size along the Y axis",
        "default": 10.0
      },
      "height": {
        "type": "float",
        "description": "Size along the Z axis",
        "default": 10.0
      },
      "chamfer_val": {
        "type": "float",
        "description": "Chamfer dimension",
        "default": 1.0
      }
    },
    "template": "cq.Workplane(\"XY\").box({length}, {width}, {height}).chamfer({chamfer_val})"
  },
  "filleted_box": {
    "name": "filleted_box",
    "description": "A rectangular box with filleted edges.",
    "parameters": {
      "length": {
        "type": "float",
        "description": "Size along the X axis",
        "default": 10.0
      },
      "width": {
        "type": "float",
        "description": "Size along the Y axis",
        "default": 10.0
      },
      "height": {
        "type": "float",
        "description": "Size along the Z axis",
        "default": 10.0
      },
      "fillet_val": {
        "type": "float",
        "description": "Fillet radius",
        "default": 1.0
      }
    },
    "template": "cq.Workplane(\"XY\").box({length}, {width}, {height}).fillet({fillet_val})"
  },
  "rounded_cylinder": {
    "name": "rounded_cylinder",
    "description": "A cylinder with filleted end edges.",
    "parameters": {
      "radius": {
        "type": "float",
        "description": "Radius of the cylinder base",
        "default": 5.0
      },
      "height": {
        "type": "float",
        "description": "Height of the cylinder",
        "default": 10.0
      },
      "fillet_val": {
        "type": "float",
        "description": "Fillet radius on the cylinder edges",
        "default": 0.5
      }
    },
    "template": "cq.Workplane(\"XY\").cylinder({height}, {radius}).edges().fillet({fillet_val})"
  },
  "ring": {
    "name": "ring",
    "description": "A flat concentric ring profile extruded to a thickness.",
    "parameters": {
      "outer_radius": {
        "type": "float",
        "description": "Outer radius of the ring",
        "default": 10.0
      },
      "inner_radius": {
        "type": "float",
        "description": "Inner radius of the ring",
        "default": 7.0
      },
      "thickness": {
        "type": "float",
        "description": "Thickness of the ring",
        "default": 2.0
      }
    },
    "template": "cq.Workplane(\"XY\").circle({outer_radius}).circle({inner_radius}).extrude({thickness})"
  },
  "profile_extrude": {
    "name": "profile_extrude",
    "description": "Extrude an arbitrary closed 2D polygon profile (list of [x, y] points in mm) to a given height along +Z. Force-multiplier for brackets, cams, gears, and other prismatic parts the fixed primitives can't express.",
    "parameters": {
      "profile": {
        "type": "profile",
        "description": "Ordered list of [x, y] points (mm) forming the closed cross-section; do not repeat the first point",
        "default": [
          [
            0.0,
            0.0
          ],
          [
            10.0,
            0.0
          ],
          [
            0.0,
            10.0
          ]
        ]
      },
      "height": {
        "type": "float",
        "description": "Extrusion height along Z",
        "default": 5.0
      }
    },
    "template": "cq.Workplane(\"XY\").polyline({profile}).close().extrude({height})"
  },
  "revolve": {
    "name": "revolve",
    "description": "Revolve a closed 2D profile (list of [x, y] points, all x >= 0) about the Y axis to sweep a solid of revolution. Force-multiplier for bottles, nozzles, flanges, and turned parts.",
    "parameters": {
      "profile": {
        "type": "profile",
        "description": "Ordered list of [x, y] points (mm) with x >= 0; revolved about the line x = 0 (the Y axis)",
        "default": [
          [
            0.0,
            0.0
          ],
          [
            5.0,
            0.0
          ],
          [
            5.0,
            10.0
          ],
          [
            0.0,
            10.0
          ]
        ]
      },
      "angle": {
        "type": "float",
        "description": "Sweep angle in degrees (360 for a full solid of revolution)",
        "default": 360.0
      }
    },
    "template": "cq.Workplane(\"XY\").polyline({profile}).close().revolve({angle}, (0, 0, 0), (0, 1, 0))"
  }
}