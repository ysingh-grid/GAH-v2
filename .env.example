GEMINI_API_KEY="enter-your-key"

# REQUIRED if you run `docker compose --profile temporal` (or ./restart.sh,
# which always includes that profile). docker-compose.yml reads this from
# YOUR SHELL/THIS FILE to fill backend's TEMPORAL_HOST — it does NOT infer it
# from --profile temporal being passed. Leave it UNSET (or delete the line)
# ONLY if you run `docker compose up` with no profile at all (backend-only,
# in-process geometry, no Temporal container exists to connect to).
# Symptom if this is missing while the temporal profile IS running: designs
# still generate and save to outputs/, but the Temporal Web UI (:8088) shows
# zero activity — the backend silently fell back to in-process.
TEMPORAL_HOST=temporal:7233

# Set when running docker compose --profile studio
# FORGECAD_STUDIO_URL=http://localhost:4000